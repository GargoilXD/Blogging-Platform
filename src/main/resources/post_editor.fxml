<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.blogging.platform.Controllers.PostEditorController">
   <top>
      <Button mnemonicParsing="false" onMouseClicked="#OnBackPressed" text="Back">
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </Button>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="PostLabel" text="Create Post">
               <font>
                  <Font name="Consolas Bold" size="18.0" />
               </font>
            </Label>
            <VBox prefHeight="31.0" prefWidth="580.0">
               <children>
                  <Label text="Title: " />
                  <TextField fx:id="TitleField" />
               </children>
            </VBox>
            <VBox prefHeight="226.0" prefWidth="580.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Body: " />
                  <TextArea fx:id="Body" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <HBox spacing="2.0">
               <children>
                  <Label alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Tags: " wrapText="true" />
                  <FlowPane fx:id="TagFlowPane" hgap="2.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" vgap="2.0" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="TagComboBox" editable="true" prefHeight="24.0" prefWidth="189.0" promptText="Select Or Add Tag" />
                  <Button fx:id="AddTagButton" mnemonicParsing="false" onMouseClicked="#OnAddTagPressed" prefHeight="24.0" prefWidth="99.0" text="Add" />
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <RadioButton fx:id="DraftRadioButton" mnemonicParsing="false" text="Draft" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="15.0" prefWidth="580.0" spacing="5.0">
               <children>
                  <Button fx:id="FinishButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#OnPostPressed" text="Finish" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
